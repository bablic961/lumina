# ── core ──
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
PORT=3000

# ── OAuth (optional: providers appear on the login page only when filled in) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# ── storage: local disk by default, S3/Blob when configured ──
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=100

# ── integrations (each degrades gracefully when the key is missing) ──
OPENWEATHER_API_KEY=
GIPHY_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── web push (generate: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lumina.local

# ── email (verification / password reset) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lumina <no-reply@lumina.local>"
