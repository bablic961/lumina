{
  "name": "lumina",
  "version": "0.1.0",
  "private": true,
  "description": "Lumina — luminous glassmorphism web messenger",
  "scripts": {
    "dev": "node server.js",
    "build": "node prisma/provider.js && prisma generate && next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "node prisma/provider.js && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@emoji-mart/data": "1.1.2",
    "@emoji-mart/react": "1.1.1",
    "@prisma/client": "5.12.1",
    "@tanstack/react-query": "5.28.14",
    "@vercel/blob": "2.8.0",
    "axios": "1.20.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.0",
    "date-fns": "3.6.0",
    "emoji-mart": "5.5.2",
    "framer-motion": "11.0.24",
    "highlight.js": "11.9.0",
    "i18next": "23.10.1",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.363.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "nodemailer": "7.0.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "14.2.3",
    "react-hook-form": "7.51.2",
    "react-i18next": "14.1.0",
    "react-markdown": "9.0.1",
    "react-window": "1.8.10",
    "sharp": "0.35.4",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "2.2.2",
    "tesseract.js": "5.0.5",
    "wavesurfer.js": "7.7.9",
    "web-push": "3.6.7",
    "webrtc-adapter": "8.2.3",
    "zod": "3.25.76",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.5",
    "@types/nodemailer": "6.4.14",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.24",
    "@types/react-window": "1.8.8",
    "@types/web-push": "3.6.3",
    "autoprefixer": "10.4.19",
    "cross-env": "7.0.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.38",
    "prisma": "5.12.1",
    "tailwindcss": "3.4.3",
    "tsx": "4.23.13",
    "typescript": "5.4.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
